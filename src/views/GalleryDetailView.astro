---
import { render, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Locale } from "../i18n/config";
import { withBase } from "../utils/paths";

interface Props {
  locale: Locale;
  entry: CollectionEntry<"gallery">;
}

const { locale, entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout locale={locale} title={`${entry.data.title} | ABOYL-AIS`} description={entry.data.summary}>
  <article class="mx-auto max-w-4xl px-5 pt-12 md:px-8 md:pt-16">
    <div class:list={[
      "paper-panel rounded-[2rem] px-5 py-7 md:rounded-[2.5rem] md:px-10 md:py-9",
      entry.data.kind === "Quote" ? "quote-wash" : "gallery-wash"
    ]}>
      <p class="section-kicker">
        {entry.data.date.toLocaleDateString(locale === "zh" ? "zh-CN" : "en-US")} · {entry.data.kind}
        {entry.data.category && ` · ${entry.data.category}`}
        {" · "}
        {entry.data.medium}
      </p>
      <h1 class="mt-4 font-display text-[clamp(2rem,10vw,3.2rem)] leading-[1.02] text-text">{entry.data.title}</h1>
      <p class="mt-4 max-w-3xl text-[1rem] leading-7 text-muted md:mt-5 md:text-lg md:leading-8">{entry.data.summary}</p>
      {entry.data.image && (
        <div class="mt-6 overflow-hidden rounded-[1.5rem] border border-line bg-bg-soft p-2 md:rounded-[1.8rem]">
          <img src={withBase(entry.data.image)} alt={entry.data.title} class="max-h-[70svh] w-full rounded-[1.1rem] object-contain md:rounded-[1.25rem]" loading="lazy" />
        </div>
      )}
    </div>

    <div class="rich-copy paper-panel mt-8 rounded-[1.8rem] px-5 py-6 md:rounded-[2rem] md:px-10 md:py-8">
      <Content />
    </div>
  </article>
</BaseLayout>
