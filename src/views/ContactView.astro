---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { getSiteCopy } from "../data/site";
import type { Locale } from "../i18n/config";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getSiteCopy(locale);
---

<BaseLayout locale={locale} title={copy.contact.metaTitle} description={copy.contact.metaDescription}>
  <section class="mx-auto max-w-5xl px-5 pt-16 md:px-8">
    <SectionHeading
      kicker={copy.contact.kicker}
      title={copy.contact.title}
      intro={copy.contact.intro}
      titleClass="w-full max-w-none text-[clamp(2.15rem,4.35vw,4.3rem)] leading-[0.94] tracking-[-0.022em]"
      introClass="w-full max-w-none text-base leading-7 text-muted md:text-lg md:leading-8"
    />
    <div class="mt-8 grid gap-6">
      {copy.contact.sections.map((section) => (
        <article class="paper-panel card-lift rounded-[2.35rem] px-6 py-7 md:px-8 md:py-8">
          <p class="section-kicker">{section.kicker}</p>
          <h2 class="mt-4 font-display text-[2rem] leading-tight text-text md:text-[2.5rem]">
            {section.title}
          </h2>
          <p class="mt-4 text-base leading-8 text-muted md:text-[1.05rem]">
            {section.body}
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            {section.links.map((item) => (
              <a
                href={item.href}
                class="inline-flex min-w-0 max-w-full items-center gap-2 rounded-full border border-line bg-white/72 px-4 py-2 text-sm text-text transition-colors hover:border-line-strong hover:text-accent-deep md:text-base"
              >
                <span class="section-kicker !text-[0.62rem] !tracking-[0.22em]">{item.label}</span>
                <span class="min-w-0 break-all">{item.value}</span>
              </a>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
