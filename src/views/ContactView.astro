---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import type { Locale } from "../i18n/config";
import { requireLocalizedPageEntry } from "../utils/content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = await requireLocalizedPageEntry(locale, "contact");
---

<BaseLayout locale={locale} title={page.data.metaTitle} description={page.data.metaDescription}>
  <section class="mx-auto max-w-5xl px-5 pt-12 md:px-8 md:pt-16">
    <SectionHeading
      kicker={page.data.kicker ?? ""}
      title={page.data.title ?? ""}
      intro={page.data.intro}
      titleClass="w-full max-w-none text-[clamp(2.15rem,4.35vw,4.3rem)] leading-[0.94] tracking-[-0.022em]"
      introClass="w-full max-w-none text-base leading-7 text-muted md:text-lg md:leading-8"
    />
    <div class="mt-8 grid gap-5 md:gap-6">
      {page.data.contactSections?.map((section) => (
        <article class="paper-panel card-lift rounded-[2rem] px-5 py-6 md:rounded-[2.35rem] md:px-8 md:py-8">
          <p class="section-kicker">{section.kicker}</p>
          <h2 class="mt-3.5 font-display text-[1.7rem] leading-tight text-text sm:text-[1.9rem] md:mt-4 md:text-[2.5rem]">
            {section.title}
          </h2>
          <p class="mt-3.5 text-[0.98rem] leading-7 text-muted md:mt-4 md:text-[1.05rem] md:leading-8">
            {section.body}
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            {section.links.map((item) => (
              <a
                href={item.href}
                class="inline-flex min-w-0 w-full max-w-full items-center justify-between gap-2 rounded-[1.1rem] border border-line bg-white/72 px-4 py-3 text-sm text-text transition-colors hover:border-line-strong hover:text-accent-deep sm:w-auto sm:justify-start sm:rounded-full sm:py-2 md:text-base"
              >
                <span class="section-kicker !text-[0.72rem] !tracking-[0.22em]">{item.label}</span>
                <span class="min-w-0 break-all">{item.value}</span>
              </a>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
