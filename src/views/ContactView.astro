---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { getSiteCopy } from "../data/site";
import type { Locale } from "../i18n/config";
import { withBase } from "../utils/paths";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getSiteCopy(locale);
---

<BaseLayout locale={locale} title={copy.contact.metaTitle} description={copy.contact.metaDescription}>
  <section class="mx-auto max-w-5xl px-5 pt-16 md:px-8">
    <SectionHeading
      kicker={copy.contact.kicker}
      title={copy.contact.title}
      intro={copy.contact.intro}
    />
    <div class="mt-6 grid gap-6">
      {copy.contact.items.map((item) => (
        <div class="paper-panel card-lift rounded-[2rem] px-6 py-6">
          <div class="flex items-center gap-3">
            {item.icon && (
              <span class="flex h-11 w-11 items-center justify-center overflow-hidden rounded-full border border-line bg-white/80 shadow-[0_8px_20px_rgba(125,97,118,0.06)]">
                <img src={withBase(item.icon)} alt={item.iconAlt ?? item.label} class="h-full w-full object-cover" />
              </span>
            )}
            <p class="section-kicker">{item.label}</p>
          </div>
          {item.href ? (
            <a href={item.href} class="mt-3 inline-flex font-display text-3xl text-text hover:text-accent-deep">
              {item.value}
            </a>
          ) : (
            <div>
              <p class="mt-3 font-display text-3xl text-text">{item.value}</p>
              <p class="mt-2 text-sm leading-7 text-muted">{copy.contact.emailHint}</p>
            </div>
          )}
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
