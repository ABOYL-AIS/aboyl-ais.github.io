---
import { render, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Locale } from "../i18n/config";
import { getBrandTitle } from "../data/site";

interface Props {
  locale: Locale;
  entry: CollectionEntry<"research">;
}

const { locale, entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout locale={locale} title={`${entry.data.title} | ${getBrandTitle(locale)}`} description={entry.data.summary}>
  <article class="mx-auto max-w-4xl px-5 pt-12 md:px-8 md:pt-16">
    <div class="paper-panel rounded-[2rem] px-5 py-7 md:rounded-[2.5rem] md:px-10 md:py-9">
      <p class="section-kicker">
        {entry.data.kind} · {entry.data.venue}
      </p>
      <h1 class="mt-4 font-display text-[clamp(2rem,10vw,3.2rem)] leading-[1.02] text-text">{entry.data.title}</h1>
      <p class="mt-4 max-w-3xl text-[1rem] leading-7 text-muted md:mt-5 md:text-lg md:leading-8">{entry.data.summary}</p>
      <div class="mt-6 flex flex-wrap gap-2">
        {entry.data.tags.map((tag) => (
          <span class="rounded-full bg-accent-soft px-3 py-1 text-xs tracking-[0.14em] text-accent-deep">
            {tag}
          </span>
        ))}
      </div>
    </div>

    <div class="rich-copy paper-panel mt-8 rounded-[1.8rem] px-5 py-6 md:rounded-[2rem] md:px-10 md:py-8">
      <Content />
    </div>
  </article>
</BaseLayout>
