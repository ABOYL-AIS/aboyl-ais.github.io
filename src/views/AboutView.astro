---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSiteCopy } from "../data/site";
import type { Locale } from "../i18n/config";
import { withBase } from "../utils/paths";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getSiteCopy(locale);
---

<BaseLayout locale={locale} title={copy.about.metaTitle} description={copy.about.metaDescription}>
  <section class="mx-auto max-w-5xl px-5 pt-12 md:px-8 md:pt-16">
    <div class="max-w-4xl">
      <p class="section-kicker">{copy.about.kicker}</p>
      <h1 class="mt-4 w-full max-w-none font-display text-[clamp(2.3rem,3.9vw,3.9rem)] leading-[0.95] text-text">
        {copy.about.title}
      </h1>
      <p class="mt-5 max-w-3xl text-base leading-7 text-muted md:text-lg md:leading-8">
        {copy.about.intro}
      </p>

      <div class="mt-6 flex flex-wrap gap-2.5 md:gap-3">
        {copy.about.affiliations.map((item) =>
          item.href ? (
            <a
              href={item.href}
              target="_blank"
              rel="noreferrer"
              class="about-affiliation-chip inline-flex w-fit max-w-full items-center gap-2 rounded-full border border-line bg-white/76 px-4 py-2 text-sm text-text transition-colors hover:border-line-strong hover:text-accent-deep md:text-base"
            >
              {item.text}
            </a>
          ) : (
            <p class="about-affiliation-chip inline-flex w-fit max-w-full items-center rounded-full border border-line bg-white/72 px-4 py-2 text-sm text-muted md:text-base">
              {item.text}
            </p>
          )
        )}
      </div>
    </div>

    <div class="mt-8 grid gap-5 md:mt-10 md:gap-6 lg:grid-cols-[1.25fr_0.75fr] lg:items-center">
      <div class="paper-panel card-lift rounded-[2rem] px-5 py-6 md:rounded-[2.5rem] md:px-10 md:py-8">
      <div class="grid gap-6 md:grid-cols-2 md:gap-8">
        <div>
          <p class="section-kicker">{copy.about.profileLabel}</p>
          <p class="mt-3.5 text-[1rem] leading-7 text-muted md:mt-4 md:text-lg md:leading-8">{copy.about.profile.summary}</p>
        </div>

        <div>
          <p class="section-kicker">{copy.about.backgroundLabel}</p>
          <p class="mt-3.5 text-[1rem] leading-7 text-muted md:mt-4 md:text-lg md:leading-8">{copy.about.profile.background}</p>
        </div>
      </div>

      <div class="mt-8 md:mt-10">
        <div>
          <p class="section-kicker">{copy.about.keywordsLabel}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {copy.about.profile.keywords.map((item) => (
              <span class="rounded-full bg-accent-soft px-3 py-1 text-xs tracking-[0.14em] text-accent-deep">
                {item}
              </span>
            ))}
          </div>
        </div>
      </div>
      </div>

      {copy.brand.aboutPortrait ? (
        <aside class="about-portrait-card card-lift mx-auto w-full max-w-[22rem] self-center rounded-[2rem] md:max-w-[26rem] md:rounded-[2.5rem] lg:mx-0 lg:max-w-none">
          <div class="about-portrait-frame overflow-hidden rounded-[2.15rem]">
            <img
              src={withBase(copy.brand.aboutPortrait)}
              alt={copy.brand.aboutPortraitAlt}
              class="about-portrait-image block h-full w-full object-cover"
            />
          </div>
        </aside>
      ) : (
        <aside class="paper-panel surface-mist rounded-[2.5rem] px-6 py-7">
          <p class="section-kicker">Brand Assets</p>
          <p class="mt-4 font-display text-3xl leading-tight text-text">
            About 页头像、形象图或 Logo 卡片后续可以直接接到这里。
          </p>
          <p class="mt-4 text-base leading-8 text-muted">
            资源建议放到 <code>/public/images/about/</code> 或 <code>/public/images/brand/</code>，
            然后在 <code>src/data/site.ts</code> 里填写对应路径。
          </p>
        </aside>
      )}
    </div>

    <div class="mt-8 grid gap-5 md:gap-6">
      {copy.about.sections.map((section) => (
        <article class="paper-panel card-lift rounded-[1.9rem] px-5 py-6 md:rounded-[2.1rem] md:px-7 md:py-7">
          <p class="section-kicker">{section.kicker}</p>
          <h2 class="mt-3.5 font-display text-[1.7rem] leading-tight text-text sm:text-[1.9rem] md:mt-4 md:text-[2.3rem]">
            {section.title}
          </h2>
          <p class="mt-3.5 text-[0.98rem] leading-7 text-muted md:mt-4 md:text-base md:leading-8">
            {section.body}
          </p>
          {section.subsections && section.subsections.length > 0 && (
            <div class="mt-6 space-y-3.5 md:space-y-4">
              {section.subsections.map((item) => (
                <div class="rounded-[1.45rem] border border-line bg-white/72 px-4 py-4 md:rounded-[1.6rem] md:px-5 md:py-5">
                  <h3 class="font-display text-[1.35rem] leading-tight text-text md:text-[1.8rem]">
                    {item.title}
                  </h3>
                  <p class="mt-3 text-[0.98rem] leading-7 text-muted md:text-base md:leading-8">
                    {item.body}
                  </p>
                </div>
              ))}
            </div>
          )}
          {section.items && section.items.length > 0 && (
            <div class="mt-5 flex flex-wrap gap-2">
              {section.items.map((item) => (
                <span class="rounded-full border border-line bg-white/72 px-3 py-1 text-xs tracking-[0.14em] text-accent-deep md:text-[0.8rem]">
                  {item}
                </span>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
