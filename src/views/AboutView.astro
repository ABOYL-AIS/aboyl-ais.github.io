---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSiteCopy } from "../data/site";
import type { Locale } from "../i18n/config";
import { withBase } from "../utils/paths";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getSiteCopy(locale);
---

<BaseLayout locale={locale} title={copy.about.metaTitle} description={copy.about.metaDescription}>
  <section class="mx-auto max-w-5xl px-5 pt-16 md:px-8">
    <div class="max-w-4xl">
      <p class="section-kicker">{copy.about.kicker}</p>
      <h1 class="mt-4 font-display text-[clamp(2.9rem,6vw,5rem)] leading-[0.96] text-text md:whitespace-nowrap">
        {copy.about.title}
      </h1>
      <p class="mt-5 max-w-3xl text-base leading-7 text-muted md:text-lg md:leading-8">
        {copy.about.intro}
      </p>

      <div class="mt-6 flex flex-wrap gap-3">
        {copy.about.affiliations.map((item) =>
          item.href ? (
            <a
              href={item.href}
              target="_blank"
              rel="noreferrer"
              class="inline-flex w-fit max-w-full items-center gap-2 rounded-full border border-line bg-white/76 px-4 py-2 text-sm text-text transition-colors hover:border-line-strong hover:text-accent-deep md:text-base"
            >
              {item.text}
            </a>
          ) : (
            <p class="inline-flex w-fit max-w-full items-center rounded-full border border-line bg-white/72 px-4 py-2 text-sm text-muted md:text-base">
              {item.text}
            </p>
          )
        )}
      </div>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-[1.25fr_0.75fr]">
      <div class="paper-panel card-lift rounded-[2.5rem] px-7 py-8 md:px-10">
      <div class="grid gap-8 md:grid-cols-2">
        <div>
          <p class="section-kicker">{copy.about.profileLabel}</p>
          <p class="mt-4 text-lg leading-8 text-muted">{copy.about.profile.summary}</p>
        </div>

        <div>
          <p class="section-kicker">{copy.about.backgroundLabel}</p>
          <p class="mt-4 text-lg leading-8 text-muted">{copy.about.profile.background}</p>
        </div>
      </div>

      <div class="mt-10">
        <div>
          <p class="section-kicker">{copy.about.keywordsLabel}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {copy.about.profile.keywords.map((item) => (
              <span class="rounded-full bg-accent-soft px-3 py-1 text-xs tracking-[0.14em] text-accent-deep">
                {item}
              </span>
            ))}
          </div>
        </div>
      </div>
      </div>

      {copy.brand.aboutPortrait ? (
        <aside class="about-portrait-panel rounded-[2.5rem]">
          <div class="about-portrait-frame overflow-hidden rounded-[2.5rem]">
            <img
              src={withBase(copy.brand.aboutPortrait)}
              alt={copy.brand.aboutPortraitAlt}
              class="block h-full w-full object-cover"
            />
          </div>
        </aside>
      ) : (
        <aside class="paper-panel surface-mist rounded-[2.5rem] px-6 py-7">
          <p class="section-kicker">Brand Assets</p>
          <p class="mt-4 font-display text-3xl leading-tight text-text">
            About 页头像、形象图或 Logo 卡片后续可以直接接到这里。
          </p>
          <p class="mt-4 text-base leading-8 text-muted">
            资源建议放到 <code>/public/images/about/</code> 或 <code>/public/images/brand/</code>，
            然后在 <code>src/data/site.ts</code> 里填写对应路径。
          </p>
        </aside>
      )}
    </div>
  </section>
</BaseLayout>
