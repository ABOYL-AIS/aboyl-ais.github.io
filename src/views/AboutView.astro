---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Locale } from "../i18n/config";
import { getLocalizedCollection, requireLocalizedPageEntry } from "../utils/content";
import { withBase } from "../utils/paths";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = await requireLocalizedPageEntry(locale, "about");
const aboutEntries = (await getLocalizedCollection("about", locale)).sort(
  (a, b) => a.data.order - b.data.order
);
const profileEntry = aboutEntries.find((entry) => entry.data.section === "profile");
const sectionEntries = aboutEntries.filter((entry) => entry.data.section !== "profile");
const cvHref = page.data.cvFile ? withBase(page.data.cvFile) : undefined;
---

<BaseLayout locale={locale} title={page.data.metaTitle} description={page.data.metaDescription}>
  <section class="mx-auto max-w-5xl px-5 pt-12 md:px-8 md:pt-16">
    <div class="max-w-4xl">
      <p class="section-kicker">{page.data.kicker}</p>
      <h1 class="mt-4 w-full max-w-none font-display text-[clamp(2.3rem,3.9vw,3.9rem)] leading-[0.95] text-text">
        {page.data.title}
      </h1>
      <p class="mt-5 max-w-3xl text-base leading-7 text-muted md:text-lg md:leading-8">
        {page.data.intro}
      </p>

      <div class="mt-6 flex flex-wrap gap-2.5 md:gap-3">
        {page.data.affiliations?.map((item) =>
          item.href ? (
            <a
              href={item.href}
              target="_blank"
              rel="noreferrer"
              class="about-affiliation-chip inline-flex w-fit max-w-full items-center gap-2 rounded-full border border-line bg-white/76 px-4 py-2 text-sm text-text transition-colors hover:border-line-strong hover:text-accent-deep md:text-base"
            >
              {item.text}
            </a>
          ) : (
            <p class="about-affiliation-chip inline-flex w-fit max-w-full items-center rounded-full border border-line bg-white/72 px-4 py-2 text-sm text-muted md:text-base">
              {item.text}
            </p>
          )
        )}
      </div>
    </div>

    <div class="mt-8 grid gap-5 md:mt-10 md:gap-6 lg:grid-cols-[1.25fr_0.75fr] lg:items-center">
      <div class="paper-panel card-lift rounded-[2rem] px-5 py-6 md:rounded-[2.5rem] md:px-10 md:py-8">
      <div class="grid gap-6 md:grid-cols-2 md:gap-8">
        <div>
          <p class="section-kicker">{profileEntry?.data.summaryLabel ?? "Profile"}</p>
          <p class="mt-3.5 text-[1rem] leading-7 text-muted md:mt-4 md:text-lg md:leading-8">
            {profileEntry?.data.summary}
          </p>
          {cvHref && (
            <a
              href={cvHref}
              target="_blank"
              rel="noreferrer"
              class="mt-5 inline-flex w-fit items-center rounded-full border border-line bg-white/82 px-4 py-2 text-sm text-text transition-colors hover:border-line-strong hover:text-accent-deep md:mt-6"
            >
              CV
            </a>
          )}
        </div>

        <div>
          <p class="section-kicker">{profileEntry?.data.backgroundLabel ?? "Background"}</p>
          <p class="mt-3.5 text-[1rem] leading-7 text-muted md:mt-4 md:text-lg md:leading-8">
            {profileEntry?.data.background}
          </p>
        </div>
      </div>

      <div class="mt-8 md:mt-10">
        <div>
          <p class="section-kicker">{profileEntry?.data.keywordsLabel ?? "Keywords"}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {(profileEntry?.data.keywords ?? []).map((item) => (
              <span class="rounded-full bg-accent-soft px-3 py-1 text-xs tracking-[0.14em] text-accent-deep">
                {item}
              </span>
            ))}
          </div>
        </div>
      </div>
      </div>

      {page.data.portraitImage ? (
        cvHref ? (
          <a
            href={cvHref}
            target="_blank"
            rel="noreferrer"
            class="about-portrait-card card-lift mx-auto block w-full max-w-[22rem] self-center rounded-[2rem] md:max-w-[26rem] md:rounded-[2.5rem] lg:mx-0 lg:max-w-none"
          >
            <div class="about-portrait-frame overflow-hidden rounded-[2.15rem]">
              <img
                src={withBase(page.data.portraitImage)}
                alt={page.data.portraitImageAlt ?? page.data.title ?? "About portrait"}
                class="about-portrait-image block h-full w-full object-cover"
              />
            </div>
          </a>
        ) : (
          <div class="about-portrait-card card-lift mx-auto block w-full max-w-[22rem] self-center rounded-[2rem] md:max-w-[26rem] md:rounded-[2.5rem] lg:mx-0 lg:max-w-none">
            <div class="about-portrait-frame overflow-hidden rounded-[2.15rem]">
              <img
                src={withBase(page.data.portraitImage)}
                alt={page.data.portraitImageAlt ?? page.data.title ?? "About portrait"}
                class="about-portrait-image block h-full w-full object-cover"
              />
            </div>
          </div>
        )
      ) : (
        <aside class="paper-panel surface-mist rounded-[2.5rem] px-6 py-7">
          <p class="section-kicker">Brand Assets</p>
          <p class="mt-4 font-display text-3xl leading-tight text-text">
            About 页头像、形象图或 Logo 卡片后续可以直接接到这里。
          </p>
          <p class="mt-4 text-base leading-8 text-muted">
            资源建议放到 <code>/public/images/about/</code>，
            然后在 <code>src/content/&lt;locale&gt;/pages/about.md</code> 里填写对应路径。
          </p>
        </aside>
      )}
    </div>

    <div class="mt-8 grid gap-5 md:gap-6">
      {sectionEntries.map((section) => (
        <article class="paper-panel card-lift rounded-[1.9rem] px-5 py-6 md:rounded-[2.1rem] md:px-7 md:py-7">
          <p class="section-kicker">{section.data.kicker}</p>
          <h2 class="mt-3.5 font-display text-[1.7rem] leading-tight text-text sm:text-[1.9rem] md:mt-4 md:text-[2.3rem]">
            {section.data.title}
          </h2>
          {section.body && (
            <p class="mt-3.5 text-[0.98rem] leading-7 text-muted md:mt-4 md:text-base md:leading-8">
              {section.body}
            </p>
          )}
          {section.data.section === "news" && (section.data.timeline?.length ?? 0) > 0 && (
            <div class="mt-6 grid gap-4">
              {section.data.timeline?.map((item) => (
                <div class="rounded-[1.45rem] border border-line bg-white/72 px-4 py-4 md:rounded-[1.6rem] md:px-5 md:py-5">
                  <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                    <p class="min-w-0 text-[0.98rem] leading-7 text-text md:text-[1.04rem]">
                      <span class="mr-3 text-sm tracking-[0.08em] text-accent-deep">{item.date}</span>
                      <span>{item.title}</span>
                    </p>
                    {item.href && item.linkLabel && (
                    <a
                      href={item.href}
                      target="_blank"
                      rel="noreferrer"
                      class="inline-flex w-fit items-center rounded-full border border-line bg-white/82 px-4 py-2 text-sm text-text transition-colors hover:border-line-strong hover:text-accent-deep"
                    >
                      {item.linkLabel}
                    </a>
                    )}
                  </div>
                </div>
              ))}
            </div>
          )}
          {section.data.section === "award" && (section.data.groups?.length ?? 0) > 0 && (
            <div class="mt-6 space-y-4">
              {section.data.groups?.map((group) => (
                <div class="rounded-[1.45rem] border border-line bg-white/72 px-4 py-4 md:rounded-[1.6rem] md:px-5 md:py-5">
                  <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
                    <div>
                      <p class="section-kicker">{group.label}</p>
                      <p class="mt-2 text-sm leading-6 text-muted md:text-[0.98rem]">
                        {group.description}
                      </p>
                    </div>
                    <p class="text-sm text-muted">
                      {locale === "zh" ? `共 ${group.items.length} 项` : `${group.items.length} items`}
                    </p>
                  </div>

                  <div class="mt-4 space-y-3">
                    {group.items.map((item) => (
                      <div class="flex flex-col gap-3 rounded-[1.15rem] border border-line/70 bg-white/60 px-4 py-4 md:flex-row md:items-center md:justify-between">
                        <p class="min-w-0 text-[0.98rem] leading-7 text-text md:text-[1.04rem]">
                          {item.date && <span class="mr-3 text-sm tracking-[0.08em] text-accent-deep">{item.date}</span>}
                          <span>{item.title}</span>
                        </p>
                        {(item.asset || item.href) && item.linkLabel && (
                          <a
                            href={item.asset ? withBase(`/award/${encodeURIComponent(item.asset)}`) : item.href}
                            target="_blank"
                            rel="noreferrer"
                            class="inline-flex w-fit items-center rounded-full border border-line bg-white/82 px-4 py-2 text-sm text-text transition-colors hover:border-line-strong hover:text-accent-deep"
                          >
                            {item.linkLabel}
                          </a>
                        )}
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          )}
          {section.data.section === "products" && (section.data.items?.length ?? 0) > 0 && (
            <div class="mt-6 grid gap-4">
              {section.data.items?.map((item) => (
                <div class="rounded-[1.45rem] border border-line bg-white/72 px-4 py-4 md:rounded-[1.6rem] md:px-5 md:py-5">
                  <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                    <div class="min-w-0 max-w-3xl">
                      {item.year && <p class="text-sm tracking-[0.08em] text-accent-deep">{item.year}</p>}
                      <h3 class="mt-1 font-display text-[1.35rem] leading-tight text-text md:text-[1.8rem]">
                        {item.title}
                      </h3>
                      {item.body && (
                        <p class="mt-3 text-[0.98rem] leading-7 text-muted md:text-base md:leading-8">
                          {item.body}
                        </p>
                      )}
                    </div>

                    <div class="flex flex-wrap gap-2 md:max-w-[16rem] md:justify-end">
                      {item.links?.map((link) => (
                        <a
                          href={link.href}
                          target="_blank"
                          rel="noreferrer"
                          class="inline-flex items-center rounded-full border border-line bg-white/82 px-4 py-2 text-sm text-text transition-colors hover:border-line-strong hover:text-accent-deep"
                        >
                          {link.label}
                        </a>
                      ))}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          )}
          {section.data.section === "collaborators" && (section.data.items?.length ?? 0) > 0 && (
            <div class="mt-6 grid gap-4">
              {section.data.items?.map((item) => (
                <a
                  href={item.href!}
                  target="_blank"
                  rel="noreferrer"
                  class="block rounded-[1.45rem] border border-line bg-white/72 px-4 py-4 transition-colors hover:border-line-strong hover:text-accent-deep md:rounded-[1.6rem] md:px-5 md:py-5"
                >
                  <div class="flex flex-col gap-2 md:flex-row md:items-start md:justify-between">
                    <div class="min-w-0">
                      <h3 class="font-display text-[1.35rem] leading-tight text-text md:text-[1.8rem]">
                        {item.title}
                      </h3>
                      {item.subtitle && (
                        <p class="mt-1 text-[0.98rem] leading-7 text-muted md:text-base">
                          {item.subtitle}
                        </p>
                      )}
                      {item.note && (
                        <p class="mt-2 text-sm leading-6 text-accent-deep md:text-[0.98rem]">
                          {item.note}
                        </p>
                      )}
                    </div>
                    <span class="mt-1 inline-flex w-fit items-center rounded-full border border-line bg-white/82 px-4 py-2 text-sm text-text transition-colors group-hover:border-line-strong group-hover:text-accent-deep md:mt-0">
                      {item.linkLabel ?? "Visit"}
                    </span>
                  </div>
                </a>
              ))}
            </div>
          )}
          {section.data.subsections && section.data.subsections.length > 0 && (
            <div class="mt-6 space-y-3.5 md:space-y-4">
              {section.data.subsections.map((item) => (
                <div class="rounded-[1.45rem] border border-line bg-white/72 px-4 py-4 md:rounded-[1.6rem] md:px-5 md:py-5">
                  <h3 class="font-display text-[1.35rem] leading-tight text-text md:text-[1.8rem]">
                    {item.title}
                  </h3>
                  <p class="mt-3 text-[0.98rem] leading-7 text-muted md:text-base md:leading-8">
                    {item.body}
                  </p>
                </div>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
