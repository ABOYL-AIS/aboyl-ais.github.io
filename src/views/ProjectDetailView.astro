---
import { render, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Locale } from "../i18n/config";
import { withBase } from "../utils/paths";

interface Props {
  locale: Locale;
  entry: CollectionEntry<"projects">;
}

const { locale, entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout locale={locale} title={`${entry.data.title} | ABOYL-AIS`} description={entry.data.summary}>
  <article class="mx-auto max-w-4xl px-5 pt-12 md:px-8 md:pt-16">
    <div class="paper-panel rounded-[2rem] px-5 py-7 md:rounded-[2.5rem] md:px-10 md:py-9">
      <p class="section-kicker">{entry.data.year} · {entry.data.role}</p>
      <h1 class="mt-4 font-display text-[clamp(2rem,10vw,3.2rem)] leading-[1.02] text-text">{entry.data.title}</h1>
      <p class="mt-4 max-w-3xl text-[1rem] leading-7 text-muted md:mt-5 md:text-lg md:leading-8">{entry.data.summary}</p>

      <div class="mt-7 overflow-hidden rounded-[1.6rem] border border-line bg-[linear-gradient(180deg,rgba(255,255,255,0.74),rgba(238,243,251,0.82))] p-2.5 md:mt-8 md:rounded-[2rem] md:p-4">
        <img
          src={withBase(entry.data.cover)}
          alt={entry.data.coverAlt}
          class="block w-full rounded-[1.5rem] border border-white/55 shadow-[0_22px_48px_rgba(71,78,102,0.12)]"
          loading="lazy"
        />
      </div>

      <div class="mt-6 flex flex-wrap gap-2">
        {entry.data.tags.map((tag) => (
          <span class="rounded-full bg-accent-soft px-3 py-1 text-xs tracking-[0.16em] text-accent-deep">
            {tag}
          </span>
        ))}
      </div>

      <div class="mt-6 flex flex-wrap gap-3">
        {entry.data.github && (
          <a href={withBase(entry.data.github)} class="inline-flex min-w-0 items-center justify-center rounded-full border border-line bg-white/78 px-4 py-2 text-sm text-text hover:border-line-strong hover:text-accent-deep">
            GitHub
          </a>
        )}
        {entry.data.demo && (
          <a href={withBase(entry.data.demo)} class="inline-flex min-w-0 items-center justify-center rounded-full border border-line bg-white/78 px-4 py-2 text-sm text-text hover:border-line-strong hover:text-accent-deep">
            Demo
          </a>
        )}
        {entry.data.writeup && (
          <a href={withBase(entry.data.writeup)} class="inline-flex min-w-0 items-center justify-center rounded-full border border-line bg-white/78 px-4 py-2 text-sm text-text hover:border-line-strong hover:text-accent-deep">
            Write-up
          </a>
        )}
      </div>
    </div>

    <div class="rich-copy paper-panel mt-8 rounded-[1.8rem] px-5 py-6 md:rounded-[2rem] md:px-10 md:py-8">
      <Content />
    </div>
  </article>
</BaseLayout>
