---
import type { Locale } from "../i18n/config";
import BaseLayout from "../layouts/BaseLayout.astro";
import { requireLocalizedPageEntry } from "../utils/content";
import { getGalleryImages, type GalleryFolder } from "../utils/gallery";
import { withBase } from "../utils/paths";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = await requireLocalizedPageEntry(locale, "gallery");
const categoryMeta = page.data.categories ?? [];

const categories = await Promise.all(
  categoryMeta.map(async (item) => ({
    ...item,
    images: await getGalleryImages(item.id as GalleryFolder)
  }))
);
---

<BaseLayout
  locale={locale}
  title={page.data.metaTitle}
  description={page.data.metaDescription}
>
  <section class="mx-auto max-w-6xl px-5 pt-12 md:px-8 md:pt-16" data-gallery-root data-default-category="avatar">
    <div class="w-full">
      <p class="section-kicker">{page.data.kicker}</p>
      <h1 class="mt-4 w-full max-w-none font-display text-[clamp(2.05rem,3.35vw,3.4rem)] leading-[0.96] tracking-[-0.02em] text-text">
        {page.data.title}
      </h1>
      <p class="mt-5 w-full max-w-none text-base leading-7 text-muted md:text-lg md:leading-8">
        {page.data.intro}
      </p>
    </div>

    <div class="gallery-filter-bar mt-8 flex gap-3 overflow-x-auto pb-1 md:mt-10 md:flex-wrap">
      {categories.map((category, index) => (
        <button
          type="button"
          class:list={["gallery-filter shrink-0", index === 0 && "is-active"]}
          data-gallery-filter={category.id}
        >
          {category.label}
        </button>
      ))}
    </div>

    <div class="mt-10 space-y-10">
      {categories.map((category, index) => (
        <section
          data-gallery-panel={category.id}
          hidden={index !== 0}
        >
          <p class="section-kicker">{category.title}</p>
          {category.note && (
            <p class="mt-2 max-w-3xl text-sm leading-7 text-muted md:text-base">
              {category.note}
            </p>
          )}
          <div class="gallery-image-wall mt-5 columns-2 gap-3 sm:gap-5 xl:columns-3">
            {category.images.map((image) => (
              <a
                href={withBase(image.src)}
                target="_blank"
                rel="noreferrer"
                class="gallery-image-tile mb-3 block break-inside-avoid overflow-hidden rounded-[1.1rem] sm:mb-5 sm:rounded-[1.8rem]"
              >
                <img
                  src={image.src}
                  alt={category.title}
                  loading="lazy"
                  class="gallery-image-tile__image block h-auto w-full object-cover"
                />
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-gallery-root]");
    if (!root) return;

    const buttons = Array.from(root.querySelectorAll("[data-gallery-filter]"));
    const panels = Array.from(root.querySelectorAll("[data-gallery-panel]"));

    const setActive = (category) => {
      buttons.forEach((button) => {
        button.classList.toggle("is-active", button.dataset.galleryFilter === category);
      });

      panels.forEach((panel) => {
        panel.hidden = panel.dataset.galleryPanel !== category;
      });
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => setActive(button.dataset.galleryFilter));
    });

    setActive(root.dataset.defaultCategory || "avatar");
  })();
</script>
