---
import HeroPanel from "../components/HeroPanel.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ResearchCard from "../components/ResearchCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import WritingCard from "../components/WritingCard.astro";
import { getSiteCopy } from "../data/site";
import type { Locale } from "../i18n/config";
import { localizePath } from "../i18n/config";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLocalizedCollection, getEntrySlug } from "../utils/content";
import { withBase } from "../utils/paths";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getSiteCopy(locale);

function shuffleEntries<T>(items: T[]) {
  const shuffled = [...items];
  for (let i = shuffled.length - 1; i > 0; i -= 1) {
    const j = Math.floor(Math.random() * (i + 1));
    [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
  }
  return shuffled;
}

const projects = (await getLocalizedCollection("projects", locale))
  .filter((entry) => entry.data.featured)
  .slice(0, 2);

const research = (await getLocalizedCollection("research", locale))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);

const notes = (await getLocalizedCollection("notes", locale))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);

const galleryPreview = shuffleEntries(
  (await getLocalizedCollection("gallery", locale))
  .filter((entry) => entry.data.kind !== "Quote")
  .filter((entry) => Boolean(entry.data.image))
).slice(0, 4);

const projectGridClass =
  projects.length > 1 ? "mt-10 grid gap-6 lg:grid-cols-2" : "mt-10";
const researchGridClass =
  research.length > 1 ? "mt-10 grid gap-6 lg:grid-cols-2" : "mt-10";
---

<BaseLayout locale={locale} htmlClass="home-snap-page" bodyClass="home-snap-page">
  <HeroPanel locale={locale} />

  <section class="home-snap-section mx-auto mt-20 max-w-6xl px-5 md:px-8">
    <div class="paper-panel card-lift surface-lilac rounded-[2.8rem] px-7 py-9 md:px-10">
      <p class="section-kicker">{copy.home.designPrinciple.kicker}</p>
      <p class="mt-5 max-w-4xl font-display text-3xl leading-tight text-text md:text-5xl">
        {copy.home.designPrinciple.title}
      </p>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-muted">{copy.home.designPrinciple.body}</p>
    </div>
  </section>

  <section class="home-snap-section mx-auto mt-20 max-w-6xl px-5 md:px-8">
    <SectionHeading
      kicker={copy.home.selectedProjects.kicker}
      title={copy.home.selectedProjects.title}
      intro={copy.home.selectedProjects.intro}
    />

    <div class={projectGridClass}>
      {projects.map((entry) => (
        <ProjectCard
          title={entry.data.title}
          summary={entry.data.summary}
          year={entry.data.year}
          role={entry.data.role}
          roleLabel={copy.common.roleLabel}
          detailLabel={copy.common.viewDetail}
          status={entry.data.status}
          tags={entry.data.tags}
          cover={entry.data.cover}
          coverAlt={entry.data.coverAlt}
          href={localizePath(locale, `/projects/${getEntrySlug(entry.id)}/`)}
        />
      ))}
    </div>
  </section>

  <section class="home-snap-section mx-auto mt-20 max-w-6xl px-5 pb-8 md:px-8">
    <SectionHeading
      kicker={copy.home.research.kicker}
      title={copy.home.research.title}
      intro={copy.home.research.intro}
    />

    <div class={researchGridClass}>
      {research.map((entry) => (
        <ResearchCard
          title={entry.data.title}
          summary={entry.data.summary}
          kind={entry.data.kind}
          venue={entry.data.venue}
          venueLabel={copy.common.venueLabel}
          detailLabel={copy.common.viewDetail}
          date={entry.data.date.toLocaleDateString(locale === "zh" ? "zh-CN" : "en-US")}
          tags={entry.data.tags}
          href={localizePath(locale, `/research/${getEntrySlug(entry.id)}/`)}
        />
      ))}
    </div>
  </section>

  <section class="home-snap-section mx-auto mt-20 max-w-6xl px-5 pb-8 md:px-8">
    <SectionHeading
      kicker={copy.home.notes.kicker}
      title={copy.home.notes.title}
      intro={copy.home.notes.intro}
    />

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      {notes.map((entry) => (
        <WritingCard
          title={entry.data.title}
          summary={entry.data.summary}
          date={entry.data.date.toLocaleDateString(locale === "zh" ? "zh-CN" : "en-US")}
          readingTime={entry.data.kind}
          href={localizePath(locale, `/notes/${getEntrySlug(entry.id)}/`)}
          viewLabel={copy.common.viewContent}
        />
      ))}
    </div>
  </section>

  <section class="home-snap-section mx-auto mt-20 max-w-6xl px-5 pb-8 md:px-8">
    <SectionHeading
      kicker={copy.home.galleryPreview.kicker}
      title={copy.home.galleryPreview.title}
      intro={copy.home.galleryPreview.intro}
    />

    <div class="mt-10 grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
      {galleryPreview.map((entry) => (
        <a
          href={localizePath(locale, `/gallery/${getEntrySlug(entry.id)}/`)}
          class="gallery-image-tile paper-panel block overflow-hidden rounded-[2rem]"
        >
          <div class="aspect-[4/5] overflow-hidden">
            <img
              src={withBase(entry.data.image!)}
              alt={entry.data.title}
              loading="lazy"
              class="gallery-image-tile__image h-full w-full object-cover"
            />
          </div>
          <div class="px-5 py-5">
            <p class="section-kicker">{entry.data.medium}</p>
            <h3 class="mt-3 font-display text-[1.65rem] leading-[1.02] text-text">
              {entry.data.title}
            </h3>
            <p class="mt-3 text-sm leading-7 text-muted">{entry.data.summary}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
