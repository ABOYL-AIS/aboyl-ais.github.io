---
import SectionHeading from "../components/SectionHeading.astro";
import WritingCard from "../components/WritingCard.astro";
import { getSiteCopy } from "../data/site";
import type { Locale } from "../i18n/config";
import { localizePath } from "../i18n/config";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntrySlug, getLocalizedCollection } from "../utils/content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getSiteCopy(locale);
const notes = (await getLocalizedCollection("notes", locale)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout
  locale={locale}
  title={copy.collections.notes.metaTitle}
  description={copy.collections.notes.metaDescription}
>
  <section class="mx-auto max-w-6xl px-5 pt-16 md:px-8">
    <SectionHeading
      kicker={copy.collections.notes.kicker}
      title={copy.collections.notes.title}
      intro={copy.collections.notes.intro}
      titleClass="max-w-[13ch] text-[clamp(2.25rem,4.8vw,4.6rem)] leading-[0.93] tracking-[-0.03em]"
      introClass="max-w-4xl text-base leading-7 text-muted md:text-lg md:leading-8"
    />
    <div class="mt-10 grid gap-6">
      {notes.map((entry) => (
        <WritingCard
          title={entry.data.title}
          summary={entry.data.summary}
          date={entry.data.date.toLocaleDateString(locale === "zh" ? "zh-CN" : "en-US")}
          readingTime={entry.data.kind}
          href={localizePath(locale, `/notes/${getEntrySlug(entry.id)}/`)}
          viewLabel={copy.common.viewContent}
        />
      ))}
    </div>
  </section>
</BaseLayout>
