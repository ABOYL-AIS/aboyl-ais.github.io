---
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { getSiteCopy } from "../data/site";
import type { Locale } from "../i18n/config";
import { localizePath } from "../i18n/config";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntrySlug, getLocalizedCollection, requireLocalizedPageEntry } from "../utils/content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getSiteCopy(locale);
const page = await requireLocalizedPageEntry(locale, "projects");
const projects = (await getLocalizedCollection("projects", locale)).sort((a, b) =>
  b.data.year.localeCompare(a.data.year)
);
---

<BaseLayout
  locale={locale}
  title={page.data.metaTitle}
  description={page.data.metaDescription}
>
  <section class="mx-auto max-w-6xl px-5 pt-16 md:px-8">
    <SectionHeading
      kicker={page.data.kicker ?? ""}
      title={page.data.title ?? ""}
      intro={page.data.intro}
      titleClass="w-full max-w-none text-[clamp(2rem,3.3vw,3.3rem)] leading-[0.97] tracking-[-0.02em]"
      introClass="w-full max-w-none text-base leading-7 text-muted md:text-lg md:leading-8"
    />
    <div class="mt-10 grid gap-6">
      {projects.map((entry) => (
        <ProjectCard
          title={entry.data.title}
          summary={entry.data.summary}
          year={entry.data.year}
          role={entry.data.role}
          roleLabel={copy.common.roleLabel}
          detailLabel={copy.common.viewDetail}
          status={entry.data.status}
          tags={entry.data.tags}
          cover={entry.data.cover}
          coverAlt={entry.data.coverAlt}
          href={localizePath(locale, `/projects/${getEntrySlug(entry.id)}/`)}
        />
      ))}
    </div>
  </section>
</BaseLayout>
