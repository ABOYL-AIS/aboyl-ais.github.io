---
import { withBase } from "../utils/paths";

interface Props {
  title: string;
  summary: string;
  date: string;
  readingTime: string;
  href: string;
}

const { title, summary, date, readingTime, href } = Astro.props;
---

<article class="paper-panel card-lift surface-lilac rounded-[2rem] px-6 py-6 md:px-7">
  <p class="text-xs uppercase tracking-[0.22em] text-muted">{date} · {readingTime}</p>
  <h3 class="mt-3 font-display text-3xl text-text">{title}</h3>
  <p class="mt-4 text-base leading-8 text-muted">{summary}</p>
  <a href={withBase(href)} class="inline-link mt-6">
    查看内容
  </a>
</article>
