---
import { withBase } from "../utils/paths";

interface Props {
  title: string;
  summary: string;
  date: string;
  readingTime: string;
  href: string;
  viewLabel?: string;
}

const { title, summary, date, readingTime, href, viewLabel = "View content" } = Astro.props;
---

<article class="paper-panel card-lift surface-lilac rounded-[1.8rem] px-5 py-5 md:rounded-[2rem] md:px-7 md:py-6">
  <p class="text-xs uppercase tracking-[0.22em] text-muted">{date} · {readingTime}</p>
  <h3 class="mt-3 font-display text-[1.8rem] leading-tight text-text md:text-3xl">{title}</h3>
  <p class="mt-4 text-[0.98rem] leading-7 text-muted md:text-base md:leading-8">{summary}</p>
  <a href={withBase(href)} class="inline-link mt-5 md:mt-6">
    {viewLabel}
  </a>
</article>
