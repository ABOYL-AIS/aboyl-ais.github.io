---
import { withBase } from "../utils/paths";

interface Props {
  kicker: string;
  title: string;
  body: string;
  href?: string;
  tone?: "rose" | "neutral" | "soft";
  className?: string;
}

const { kicker, title, body, href, tone = "neutral", className } = Astro.props;

const toneClasses = {
  rose: "surface-rose",
  neutral: "surface-lilac",
  soft: "surface-mist"
};
---

<article class:list={[
  "paper-panel card-lift rounded-[2.2rem] px-6 py-6 md:px-7 md:py-7",
  toneClasses[tone],
  className
]}>
  <p class="section-kicker">{kicker}</p>
  <h3 class="mt-3 font-display text-3xl leading-tight text-text md:text-[2.05rem]">{title}</h3>
  <p class="mt-4 max-w-[28rem] text-base leading-8 text-muted">{body}</p>
  {href && (
    <a href={withBase(href)} class="inline-link mt-6">
      查看内容
    </a>
  )}
</article>
