---
import LanguageToggle from "./LanguageToggle.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { getSiteCopy } from "../data/site";
import { localizePath, stripLocaleFromPathname, type Locale } from "../i18n/config";
import { withBase } from "../utils/paths";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { pathname } = Astro.url;
const copy = getSiteCopy(locale);
const pathWithoutLocale = stripLocaleFromPathname(pathname);
const navWrapClass =
  locale === "en"
    ? "flex items-center justify-center gap-0.5 text-[0.84rem] text-muted lg:gap-1 xl:gap-1.5"
    : "flex items-center justify-center gap-2 text-sm text-muted";
const navItemClass =
  locale === "en"
    ? "rounded-full px-2 py-1.5 transition-colors lg:px-2.5 xl:px-3"
    : "rounded-full px-3 py-1.5 transition-colors";
---

<header class="sticky top-0 z-30">
  <div class="mx-auto max-w-6xl px-5 pt-3 md:px-8 md:pt-4">
    <div class="hidden items-center gap-4 md:grid md:grid-cols-[minmax(0,1fr)_auto] xl:gap-6">
      <div class="paper-panel surface-rose rounded-full px-6 py-3">
        <div class="grid items-center gap-8 md:grid-cols-[auto_1fr]">
          <a href={withBase(localizePath(locale, "/"))} class="flex min-w-0 items-center gap-3 text-text">
            {copy.brand.markImage ? (
              <span class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-full border border-line-strong bg-white/90 shadow-[0_8px_20px_rgba(125,97,118,0.08)]">
                <img
                  src={withBase(copy.brand.markImage)}
                  alt={copy.brand.markImageAlt}
                  class="h-full w-full object-cover"
                />
              </span>
            ) : (
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-line-strong bg-white/90 font-display text-lg font-semibold text-accent-deep shadow-[0_8px_20px_rgba(125,97,118,0.08)]">
                {copy.brand.markLetter}
              </span>
            )}
            <div class="min-w-0">
              {copy.brand.wordmarkImage ? (
                <img
                  src={withBase(copy.brand.wordmarkImage)}
                  alt={copy.brand.wordmarkImageAlt}
                  class="h-8 w-auto"
                />
              ) : (
                <div class="flex min-w-0 items-baseline gap-2.5">
                  <p class="shrink-0 font-display text-lg leading-none">{copy.name}</p>
                  <p class="truncate text-[0.66rem] leading-none tracking-[0.24em] text-muted">{copy.secondaryName}</p>
                </div>
              )}
              <p class="mt-1.5 max-w-[11rem] text-[0.68rem] leading-[1.2] tracking-[0.16em] text-muted">
                {copy.brand.editionLabel}
              </p>
            </div>
          </a>

          <nav class={navWrapClass}>
            {copy.nav.map((item) => {
              const localizedHref = localizePath(locale, item.href);
              const resolvedHref = withBase(localizedHref);
              const active =
                item.href === "/"
                  ? pathWithoutLocale === "/"
                  : pathWithoutLocale.startsWith(item.href);

              return (
                <a
                  href={resolvedHref}
                  class:list={[
                    navItemClass,
                    active
                      ? "bg-accent-soft/92 text-accent-deep shadow-[0_10px_24px_rgba(191,134,152,0.14)] dark:bg-white/10 dark:text-text dark:shadow-[0_12px_28px_rgba(0,0,0,0.24)]"
                      : "text-muted hover:bg-accent-soft/55 hover:text-text"
                  ]}
                >
                  {item.label}
                </a>
              );
            })}
          </nav>
        </div>
      </div>

      <div class="header-utility-island">
        <div class="header-utility-panel">
          <LanguageToggle locale={locale} pathname={pathname} label={copy.common.languageToggle} />
          <ThemeToggle
            label={copy.common.themeToggle}
            dayLabel={copy.common.dayMode}
            nightLabel={copy.common.nightMode}
          />
        </div>
      </div>
    </div>

    <div class="md:hidden">
      <div class="paper-panel rounded-[1.7rem] px-4 py-3">
        <div class="flex items-center justify-between gap-4">
          <a href={withBase(localizePath(locale, "/"))} class="flex min-w-0 items-center gap-3 text-text">
            {copy.brand.markImage ? (
              <span class="flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-full border border-line-strong bg-white/90 shadow-[0_8px_20px_rgba(125,97,118,0.08)]">
                <img
                  src={withBase(copy.brand.markImage)}
                  alt={copy.brand.markImageAlt}
                  class="h-full w-full object-cover"
                />
              </span>
            ) : (
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-line-strong bg-white/90 font-display text-base font-semibold text-accent-deep shadow-[0_8px_20px_rgba(125,97,118,0.08)]">
                {copy.brand.markLetter}
              </span>
            )}
            <div class="min-w-0">
              {copy.brand.wordmarkImage ? (
                <img
                  src={withBase(copy.brand.wordmarkImage)}
                  alt={copy.brand.wordmarkImageAlt}
                  class="h-8 w-auto"
                />
              ) : (
                <div class="flex min-w-0 items-baseline gap-2">
                  <p class="shrink-0 font-display text-lg leading-none">{copy.name}</p>
                  <p class="truncate text-[0.58rem] leading-none tracking-[0.2em] text-muted">{copy.secondaryName}</p>
                </div>
              )}
              <p class="mt-1.5 max-w-[8.5rem] text-[0.62rem] leading-[1.2] tracking-[0.14em] text-muted sm:max-w-[10.5rem] sm:text-[0.68rem] sm:tracking-[0.16em]">
                {copy.brand.editionLabel}
              </p>
            </div>
          </a>

          <details class="group relative">
            <summary class="flex cursor-pointer list-none items-center gap-2 rounded-full border border-line bg-white/75 px-3 py-2 text-sm text-text shadow-[0_8px_20px_rgba(125,97,118,0.06)] marker:content-none">
              <span class="font-display text-base">{copy.common.menu}</span>
              <span class="text-xs tracking-[0.16em] text-muted transition-transform group-open:rotate-45">
                +
              </span>
            </summary>

            <div class="absolute right-0 top-[calc(100%+0.9rem)] z-10 w-[min(20rem,calc(100vw-2.5rem))] overflow-hidden rounded-[1.45rem] border border-line bg-white/88 p-3 shadow-[0_24px_50px_rgba(71,78,102,0.12)] backdrop-blur-xl">
              <div class="mb-3 flex flex-wrap items-center justify-between gap-3 px-1">
                <LanguageToggle
                  locale={locale}
                  pathname={pathname}
                  label={copy.common.languageToggle}
                />
                <ThemeToggle
                  label={copy.common.themeToggle}
                  dayLabel={copy.common.dayMode}
                  nightLabel={copy.common.nightMode}
                />
              </div>

              <nav class="grid gap-1.5">
                {copy.nav.map((item) => {
                  const localizedHref = localizePath(locale, item.href);
                  const resolvedHref = withBase(localizedHref);
                  const active =
                    item.href === "/"
                      ? pathWithoutLocale === "/"
                      : pathWithoutLocale.startsWith(item.href);

                  return (
                    <a
                      href={resolvedHref}
                      class:list={[
                        "rounded-[1rem] px-4 py-3 text-sm transition-colors",
                        active
                          ? "bg-accent-soft/70 text-text"
                          : "text-muted hover:bg-white hover:text-text"
                      ]}
                    >
                      {item.label}
                    </a>
                  );
                })}
              </nav>
            </div>
          </details>
        </div>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const THEME_KEY = "aboyl-theme";
    const root = document.documentElement;
    const body = document.body;
    const metaTheme = document.querySelector('meta[name="theme-color"]');

    const setTheme = (value) => {
      root.dataset.theme = value;
      root.style.colorScheme = value;
      if (body) {
        body.dataset.theme = value;
        body.style.colorScheme = value;
      }
      if (metaTheme) {
        metaTheme.setAttribute("content", value === "dark" ? "#16161d" : "#fcf9f4");
      }
      document.querySelectorAll(".js-theme-toggle").forEach((toggle) => {
        toggle.querySelectorAll("[data-theme-value]").forEach((item) => {
          const active = item.dataset.themeValue === value;
          item.classList.toggle("toggle-chip--active", active);
          item.setAttribute("aria-pressed", String(active));
        });
      });
    };

    const getStoredTheme = () => {
      const stored = localStorage.getItem(THEME_KEY);
      if (stored === "light" || stored === "dark") {
        return stored;
      }
      return root.dataset.theme === "dark" ? "dark" : "light";
    };

    const sync = () => setTheme(getStoredTheme());

    sync();

    document.querySelectorAll(".js-theme-toggle").forEach((toggle) => {
      toggle.querySelectorAll("[data-theme-value]").forEach((button) => {
        button.addEventListener("click", () => {
          const value = button.dataset.themeValue;
          if (value !== "light" && value !== "dark") return;
          localStorage.setItem(THEME_KEY, value);
          setTheme(value);
        });
      });
    });

    const media = window.matchMedia("(prefers-color-scheme: dark)");
    media.addEventListener("change", () => {
      if (!localStorage.getItem(THEME_KEY)) {
        setTheme(media.matches ? "dark" : "light");
      }
    });
  })();
</script>
