---
import LanguageToggle from "./LanguageToggle.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { getSiteCopy } from "../data/site";
import { localizePath, stripLocaleFromPathname, type Locale } from "../i18n/config";
import { withBase } from "../utils/paths";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { pathname } = Astro.url;
const copy = getSiteCopy(locale);
const pathWithoutLocale = stripLocaleFromPathname(pathname);
---

<header class="sticky top-0 z-30">
  <div class="mx-auto max-w-6xl px-5 pt-4 md:px-8">
    <div class="relative">
      <div class="paper-panel rounded-[2rem] px-5 py-3 md:mr-[14rem] md:rounded-full">
        <div class="flex items-center justify-between gap-6 md:grid md:grid-cols-[auto_1fr] md:items-center md:gap-8">
          <a href={withBase(localizePath(locale, "/"))} class="flex items-center gap-3 text-text">
            {copy.brand.markImage ? (
              <span class="flex h-10 w-10 items-center justify-center overflow-hidden rounded-full border border-line-strong bg-white/90 shadow-[0_8px_20px_rgba(125,97,118,0.08)]">
                <img
                  src={withBase(copy.brand.markImage)}
                  alt={copy.brand.markImageAlt}
                  class="h-full w-full object-cover"
                />
              </span>
            ) : (
              <span class="flex h-10 w-10 items-center justify-center rounded-full border border-line-strong bg-white/90 font-display text-lg font-semibold text-accent-deep shadow-[0_8px_20px_rgba(125,97,118,0.08)]">
                {copy.brand.markLetter}
              </span>
            )}
            <div>
              {copy.brand.wordmarkImage ? (
                <img
                  src={withBase(copy.brand.wordmarkImage)}
                  alt={copy.brand.wordmarkImageAlt}
                  class="h-8 w-auto"
                />
              ) : (
                <p class="font-display text-lg leading-none">{copy.name}</p>
              )}
              <p class="mt-1 text-xs tracking-[0.2em] text-muted">{copy.brand.editionLabel}</p>
            </div>
          </a>

          <nav class="hidden items-center justify-center gap-2 text-sm text-muted md:flex">
            {copy.nav.map((item) => {
              const localizedHref = localizePath(locale, item.href);
              const resolvedHref = withBase(localizedHref);
              const active =
                item.href === "/"
                  ? pathWithoutLocale === "/"
                  : pathWithoutLocale.startsWith(item.href);

              return (
                <a
                  href={resolvedHref}
                  class:list={[
                    "rounded-full px-3 py-1.5 transition-colors",
                    active
                      ? "bg-white/92 text-text shadow-[0_10px_24px_rgba(125,97,118,0.08)]"
                      : "text-muted hover:bg-white/70 hover:text-text"
                  ]}
                >
                  {item.label}
                </a>
              );
            })}
          </nav>

          <details class="group relative md:hidden">
            <summary class="flex cursor-pointer list-none items-center gap-2 rounded-full border border-line bg-white/75 px-3 py-2 text-sm text-text shadow-[0_8px_20px_rgba(125,97,118,0.06)] marker:content-none">
              <span class="font-display text-base">{copy.common.menu}</span>
              <span class="text-xs tracking-[0.16em] text-muted transition-transform group-open:rotate-45">
                +
              </span>
            </summary>

            <div class="absolute right-0 top-[calc(100%+0.9rem)] w-[min(18rem,78vw)] overflow-hidden rounded-[1.6rem] border border-line bg-white/88 p-3 shadow-[0_24px_50px_rgba(71,78,102,0.12)] backdrop-blur-xl">
              <div class="mb-3 flex items-center justify-between gap-3 px-1">
                <LanguageToggle
                  locale={locale}
                  pathname={pathname}
                  label={copy.common.languageToggle}
                />
                <ThemeToggle
                  label={copy.common.themeToggle}
                  dayLabel={copy.common.dayMode}
                  nightLabel={copy.common.nightMode}
                />
              </div>

              <nav class="grid gap-1">
                {copy.nav.map((item) => {
                  const localizedHref = localizePath(locale, item.href);
                  const resolvedHref = withBase(localizedHref);
                  const active =
                    item.href === "/"
                      ? pathWithoutLocale === "/"
                      : pathWithoutLocale.startsWith(item.href);

                  return (
                    <a
                      href={resolvedHref}
                      class:list={[
                        "rounded-[1rem] px-4 py-3 text-sm transition-colors",
                        active
                          ? "bg-accent-soft/70 text-text"
                          : "text-muted hover:bg-white hover:text-text"
                      ]}
                    >
                      {item.label}
                    </a>
                  );
                })}
              </nav>
            </div>
          </details>
        </div>
      </div>

      <div class="header-utility-island hidden md:block">
        <div class="paper-panel header-utility-island__panel surface-rose rounded-[1.8rem] px-3 py-3">
          <div class="header-utility-panel">
            <LanguageToggle locale={locale} pathname={pathname} label={copy.common.languageToggle} />
            <ThemeToggle
              label={copy.common.themeToggle}
              dayLabel={copy.common.dayMode}
              nightLabel={copy.common.nightMode}
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const THEME_KEY = "aboyl-theme";
    const root = document.documentElement;
    const body = document.body;
    const metaTheme = document.querySelector('meta[name="theme-color"]');

    const setTheme = (value) => {
      root.dataset.theme = value;
      root.style.colorScheme = value;
      if (body) {
        body.dataset.theme = value;
        body.style.colorScheme = value;
      }
      if (metaTheme) {
        metaTheme.setAttribute("content", value === "dark" ? "#16161d" : "#fcf9f4");
      }
      document.querySelectorAll(".js-theme-toggle").forEach((toggle) => {
        toggle.querySelectorAll("[data-theme-value]").forEach((item) => {
          const active = item.dataset.themeValue === value;
          item.classList.toggle("toggle-chip--active", active);
          item.setAttribute("aria-pressed", String(active));
        });
      });
    };

    const getStoredTheme = () => {
      const stored = localStorage.getItem(THEME_KEY);
      if (stored === "light" || stored === "dark") {
        return stored;
      }
      return root.dataset.theme === "dark" ? "dark" : "light";
    };

    const sync = () => setTheme(getStoredTheme());

    sync();

    document.querySelectorAll(".js-theme-toggle").forEach((toggle) => {
      toggle.querySelectorAll("[data-theme-value]").forEach((button) => {
        button.addEventListener("click", () => {
          const value = button.dataset.themeValue;
          if (value !== "light" && value !== "dark") return;
          localStorage.setItem(THEME_KEY, value);
          setTheme(value);
        });
      });
    });

    const media = window.matchMedia("(prefers-color-scheme: dark)");
    media.addEventListener("change", () => {
      if (!localStorage.getItem(THEME_KEY)) {
        setTheme(media.matches ? "dark" : "light");
      }
    });
  })();
</script>
