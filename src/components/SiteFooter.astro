---
import { homeSections, siteMeta } from "../data/site";
---

<footer class="mx-auto mt-24 max-w-6xl px-5 pb-10 md:px-8">
  <div class="paper-panel surface-mist rounded-[2.2rem] px-6 py-8 md:px-10">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <p class="section-kicker">Closing Note</p>
        <p class="mt-3 font-display text-2xl text-text md:text-3xl">{siteMeta.name}</p>
        <p class="mt-3 text-base leading-8 text-muted">{homeSections.footer}</p>
      </div>

      <div class="text-sm text-muted">
        <p>Static-first. Component-driven. Ready for GitHub Pages and Vercel.</p>
      </div>
    </div>
  </div>
</footer>
