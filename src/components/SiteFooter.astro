---
import type { Locale } from "../i18n/config";
import { getSiteCopy } from "../data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getSiteCopy(locale);

const iconPathMap = {
  phone: "M6.8 4.8h2.8l1 3.5-1.8 1.6a14.4 14.4 0 0 0 6.6 6.6l1.6-1.8 3.5 1v2.8c0 .7-.5 1.2-1.2 1.2A16.3 16.3 0 0 1 5.6 6c0-.7.5-1.2 1.2-1.2Z",
  email: "M4.5 6.5h15a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-15a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1Zm0 1.4 7.5 5.1 7.5-5.1",
  qq: "M12 5.4c-3.6 0-6.5 2.4-6.5 5.4 0 1.2.5 2.3 1.4 3.1l-.6 2.3 2.4-1.3c1 .4 2.1.7 3.3.7 3.6 0 6.5-2.4 6.5-5.4s-2.9-4.8-6.5-4.8Zm-2.1 5.2h.1m4.1 0h.1",
  wechat: "M9.1 6.1c-3.1 0-5.6 2.1-5.6 4.8 0 1.5.8 2.8 2.2 3.7l-.5 2 2.1-1.1c.6.1 1.1.2 1.8.2 3.1 0 5.6-2.1 5.6-4.8S12.2 6.1 9.1 6.1Zm6.9 4.5c-2.5 0-4.5 1.7-4.5 3.8 0 .5.1 1 .4 1.4l-.6 1.7 1.8-.9c.4.1.8.1 1.2.1 2.5 0 4.5-1.7 4.5-3.8s-2-2.3-4.5-2.3Z",
  github: "M12 3.9c-4.5 0-8.1 3.6-8.1 8.1 0 3.6 2.3 6.6 5.5 7.7.4.1.5-.2.5-.4v-1.6c-2.2.5-2.7-.9-2.7-.9-.4-1-.9-1.2-.9-1.2-.7-.5 0-.5 0-.5.8 0 1.2.8 1.2.8.7 1.2 1.9.8 2.3.7.1-.5.3-.8.5-1-1.8-.2-3.7-.9-3.7-4 0-.9.3-1.6.8-2.2-.1-.2-.4-1 .1-2.2 0 0 .7-.2 2.3.8a7.8 7.8 0 0 1 4.2 0c1.6-1 2.3-.8 2.3-.8.5 1.2.2 2 .1 2.2.5.6.8 1.3.8 2.2 0 3.1-1.9 3.8-3.7 4 .3.3.6.8.6 1.6v2.3c0 .2.1.5.5.4 3.2-1.1 5.5-4.1 5.5-7.7 0-4.5-3.6-8.1-8.1-8.1Z",
  team: "M8.4 10a2.2 2.2 0 1 1 0-4.4 2.2 2.2 0 0 1 0 4.4Zm7.2 1.2a2 2 0 1 1 0-4 2 2 0 0 1 0 4ZM5.5 18.3c0-2 1.7-3.7 3.9-3.7s3.9 1.7 3.9 3.7m-1.1-.1c.3-1.6 1.7-2.8 3.4-2.8 1.9 0 3.5 1.4 3.5 3.2",
} as const;
---

<footer class="mx-auto mt-24 max-w-6xl px-5 pb-10 md:px-8">
  <div class="paper-panel card-lift surface-mist rounded-[2.2rem] px-6 py-8 md:px-10">
    <div class="flex flex-col gap-8">
      <div class="max-w-3xl">
        <p class="section-kicker">{copy.common.closingNote}</p>
        <p class="mt-3 font-display text-2xl text-text md:text-3xl">{copy.name}</p>
        <p class="mt-3 text-base leading-8 text-muted">{copy.footer.note}</p>
        <p class="mt-2 text-sm leading-7 text-muted md:text-base">{copy.footer.tagline}</p>
      </div>
      <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
        {copy.footer.contacts.map((item) => (
          <a
            href={item.href}
            class="footer-contact-chip inline-flex items-center gap-3 rounded-[1.4rem] border border-line bg-white/72 px-4 py-3 text-text hover:border-line-strong hover:text-accent-deep"
          >
            <span class="footer-contact-chip__icon flex h-10 w-10 items-center justify-center rounded-full border border-line bg-white/80 text-accent-deep">
              <svg viewBox="0 0 24 24" class="h-[1.05rem] w-[1.05rem]" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={iconPathMap[item.kind]} />
              </svg>
            </span>
            <span class="min-w-0">
              <span class="section-kicker block !text-[0.62rem] !tracking-[0.2em]">{item.label}</span>
              <span class="mt-1 block break-all text-sm md:text-base">{item.value}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
