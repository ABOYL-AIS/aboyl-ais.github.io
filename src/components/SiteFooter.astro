---
import type { Locale } from "../i18n/config";
import { getSiteCopy } from "../data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getSiteCopy(locale);
---

<footer class="mx-auto mt-24 max-w-6xl px-5 pb-10 md:px-8">
  <div class="paper-panel card-lift surface-mist rounded-[2.2rem] px-6 py-8 md:px-10">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <p class="section-kicker">{copy.common.closingNote}</p>
        <p class="mt-3 font-display text-2xl text-text md:text-3xl">{copy.name}</p>
        <p class="mt-3 text-base leading-8 text-muted">{copy.footer.note}</p>
      </div>

      <div class="text-sm text-muted">
        <p>{copy.footer.tagline}</p>
      </div>
    </div>
  </div>
</footer>
