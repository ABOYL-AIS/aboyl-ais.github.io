---
interface Props {
  title?: string;
  body: string;
}

const { title = "Placeholder Content", body } = Astro.props;
---

<div class="paper-panel surface-lilac rounded-[1.8rem] px-5 py-5 md:px-6">
  <p class="section-kicker">{title}</p>
  <p class="mt-3 text-sm leading-7 text-muted md:text-[0.98rem]">
    {body}
  </p>
</div>
