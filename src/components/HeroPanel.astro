---
import type { Locale } from "../i18n/config";
import { getSiteCopy } from "../data/site";
import { withBase } from "../utils/paths";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getSiteCopy(locale);
---

<section class="hero-stage home-snap-section mx-auto max-w-6xl px-5 pt-6 md:px-8 md:pt-16">
  <div class="hero-stage__rail hero-stage__rail--left hidden xl:flex" aria-hidden="true">
    <span class="hero-stage__line"></span>
    <span class="hero-stage__label">{copy.hero.kicker}</span>
  </div>

  <div class="grid gap-5 md:gap-6 lg:grid-cols-[1.05fr_0.95fr]">
    <div class="paper-panel card-lift surface-rose relative rounded-[2.2rem] px-5 py-7 sm:px-6 sm:py-8 md:rounded-[2.8rem] md:px-10 md:py-12">
      <div class="max-w-3xl">
        <p class="section-kicker">{copy.hero.kicker}</p>
        <h1 class="mt-4 whitespace-pre-line font-display text-[clamp(2.8rem,16vw,5rem)] leading-[0.92] text-text md:mt-5 md:text-7xl">
          {copy.hero.title}
        </h1>
        <p class="mt-5 max-w-2xl text-[1rem] leading-7 text-muted md:mt-6 md:text-xl md:leading-8">
          {copy.hero.intro}
        </p>
        <p class="hero-panel__note mt-6 max-w-2xl border-l border-accent/60 pl-4 text-[0.95rem] leading-7 text-accent-deep md:mt-8">
          {copy.hero.note}
        </p>
      </div>
    </div>

    <aside class="grid gap-6">
      <div class="paper-panel card-lift hero-visual relative overflow-hidden rounded-[2rem] px-5 py-5 min-h-[20rem] sm:px-6 sm:py-6 md:rounded-[2.3rem] md:px-6 md:py-7 md:min-h-[24rem]">
        <p class="section-kicker">{copy.hero.visualKicker}</p>
        <h2 class="mt-3 max-w-xl font-display text-[1.75rem] leading-tight text-text sm:text-[1.95rem] md:mt-4 md:text-[2.45rem]">
          {copy.hero.visualTitle}
        </h2>

        <div class="hero-visual__frame mt-4 aspect-[6/5] overflow-hidden md:mt-5">
          {copy.hero.visualImage ? (
            <img
              src={withBase(copy.hero.visualImage)}
              alt={copy.hero.visualImageAlt}
              class="hero-visual__image"
              loading="eager"
              decoding="async"
            />
          ) : (
            <div class="anime-figure">
              <div class="anime-figure__halo"></div>
              <div class="anime-figure__moon"></div>
              <div class="anime-figure__veil"></div>
              <div class="anime-figure__petal anime-figure__petal--1"></div>
              <div class="anime-figure__petal anime-figure__petal--2"></div>
              <div class="anime-figure__petal anime-figure__petal--3"></div>
              <div class="anime-figure__hair"></div>
              <div class="anime-figure__face"></div>
              <div class="anime-figure__neck"></div>
              <div class="anime-figure__shoulder"></div>
              <div class="anime-figure__ribbon"></div>
            </div>
          )}
        </div>

        <p class="hero-visual__caption mt-4 md:mt-5">
          {copy.hero.visualIntro}
        </p>
      </div>
    </aside>
  </div>
</section>
