---
import type { Locale } from "../i18n/config";
import { getSiteCopy } from "../data/site";
import { withBase } from "../utils/paths";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getSiteCopy(locale);
---

<section class="hero-stage home-snap-section mx-auto max-w-6xl px-5 pt-10 md:px-8 md:pt-16">
  <div class="hero-stage__rail hero-stage__rail--left hidden xl:flex" aria-hidden="true">
    <span class="hero-stage__line"></span>
    <span class="hero-stage__label">{copy.hero.kicker}</span>
  </div>

  <div class="grid gap-6 lg:grid-cols-[1.05fr_0.95fr]">
    <div class="paper-panel card-lift surface-rose relative rounded-[2.8rem] px-7 py-10 md:px-10 md:py-12">
      <div class="max-w-3xl">
        <p class="section-kicker">{copy.hero.kicker}</p>
        <h1 class="mt-5 whitespace-pre-line font-display text-5xl leading-[0.92] text-text md:text-7xl">
          {copy.hero.title}
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-muted md:text-xl">
          {copy.hero.intro}
        </p>
        <p class="hero-panel__note mt-8 max-w-2xl border-l border-accent/60 pl-4 text-sm leading-7 text-accent-deep">
          {copy.hero.note}
        </p>
      </div>
    </div>

    <aside class="grid gap-6">
      <div class="paper-panel card-lift hero-visual relative overflow-hidden rounded-[2.3rem] px-6 py-7 min-h-[24rem]">
        <p class="section-kicker">{copy.hero.visualKicker}</p>
        <h2 class="mt-4 max-w-xl font-display text-[2rem] leading-tight text-text md:text-[2.45rem]">
          {copy.hero.visualTitle}
        </h2>

        <div class="hero-visual__frame mt-5 aspect-[6/5] overflow-hidden">
          {copy.hero.visualImage ? (
            <img
              src={withBase(copy.hero.visualImage)}
              alt={copy.hero.visualImageAlt}
              class="hero-visual__image"
              loading="eager"
              decoding="async"
            />
          ) : (
            <div class="anime-figure">
              <div class="anime-figure__halo"></div>
              <div class="anime-figure__moon"></div>
              <div class="anime-figure__veil"></div>
              <div class="anime-figure__petal anime-figure__petal--1"></div>
              <div class="anime-figure__petal anime-figure__petal--2"></div>
              <div class="anime-figure__petal anime-figure__petal--3"></div>
              <div class="anime-figure__hair"></div>
              <div class="anime-figure__face"></div>
              <div class="anime-figure__neck"></div>
              <div class="anime-figure__shoulder"></div>
              <div class="anime-figure__ribbon"></div>
            </div>
          )}
        </div>

        <p class="hero-visual__caption mt-5">
          {copy.hero.visualIntro}
        </p>
      </div>
    </aside>
  </div>
</section>
