---
import type { Locale } from "../i18n/config";
import { getSiteCopy } from "../data/site";
import { withBase } from "../utils/paths";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getSiteCopy(locale);
---

<section class="hero-stage home-snap-section mx-auto max-w-6xl px-5 pt-10 md:px-8 md:pt-16">
  <div class="hero-stage__rail hero-stage__rail--left hidden xl:flex" aria-hidden="true">
    <span class="hero-stage__line"></span>
    <span class="hero-stage__label">{copy.hero.kicker}</span>
  </div>

  <div class="hero-stage__rail hero-stage__rail--right hidden xl:flex" aria-hidden="true">
    <span class="hero-stage__petal"></span>
    <span class="hero-stage__petal hero-stage__petal--small"></span>
    <span class="hero-stage__label hero-stage__label--soft">{copy.hero.palette}</span>
  </div>

  <div class="grid gap-6 lg:grid-cols-[1.05fr_0.95fr]">
    <div class="paper-panel card-lift surface-rose relative rounded-[2.8rem] px-7 py-10 md:px-10 md:py-12">
      <div class="hero-panel__meta-chip absolute right-6 top-6 rounded-full border border-line bg-white/70 px-3 py-1 text-[0.65rem] tracking-[0.3em] text-accent-deep">
        {copy.hero.label}
      </div>

      <div class="max-w-3xl">
        <p class="section-kicker">{copy.hero.kicker}</p>
        <h1 class="mt-5 whitespace-pre-line font-display text-5xl leading-[0.92] text-text md:text-7xl">
          {copy.hero.title}
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-muted md:text-xl">
          {copy.hero.intro}
        </p>
        <p class="hero-panel__note mt-8 max-w-2xl border-l border-accent/60 pl-4 text-sm leading-7 text-accent-deep">
          {copy.hero.note}
        </p>
      </div>
    </div>

    <aside class="grid gap-6">
      <div class="paper-panel card-lift hero-visual relative overflow-hidden rounded-[2.3rem] px-6 py-7 min-h-[24rem]">
        <div class="flex items-start justify-between gap-3">
          <p class="section-kicker">{copy.hero.visualKicker}</p>
          <span class="soft-chip">{copy.hero.palette}</span>
        </div>

        <div class="hero-visual__frame mt-5">
          {copy.hero.visualImage ? (
            <img
              src={withBase(copy.hero.visualImage)}
              alt={copy.hero.visualImageAlt}
              class="hero-visual__image"
              loading="eager"
              decoding="async"
            />
          ) : (
            <div class="anime-figure">
              <div class="anime-figure__halo"></div>
              <div class="anime-figure__moon"></div>
              <div class="anime-figure__veil"></div>
              <div class="anime-figure__petal anime-figure__petal--1"></div>
              <div class="anime-figure__petal anime-figure__petal--2"></div>
              <div class="anime-figure__petal anime-figure__petal--3"></div>
              <div class="anime-figure__hair"></div>
              <div class="anime-figure__face"></div>
              <div class="anime-figure__neck"></div>
              <div class="anime-figure__shoulder"></div>
              <div class="anime-figure__ribbon"></div>
            </div>
          )}
        </div>

        <div class="mt-5 flex items-end justify-between gap-4">
          <p class="hero-visual__caption">
            {copy.hero.visualCaption}
          </p>
          <span class="soft-chip">{copy.hero.visualTag}</span>
        </div>
      </div>

      <div class="paper-panel card-lift surface-mist rounded-[2rem] px-6 py-7">
        <p class="section-kicker">{copy.hero.scopeKicker}</p>
        <div class="mt-5 space-y-5">
          {copy.hero.facts.map((fact) => (
            <div class="border-b border-line pb-4 last:border-b-0 last:pb-0">
              <p class="text-xs uppercase tracking-[0.22em] text-muted">{fact.label}</p>
              <p class="mt-2 font-display text-2xl text-text">{fact.value}</p>
            </div>
          ))}
        </div>

        <div class="mt-6 flex flex-wrap gap-2">
          {copy.hero.status.map((item) => (
            <span class="hero-status-chip rounded-full border border-line bg-white/76 px-3 py-1 text-xs tracking-[0.14em] text-accent-deep">
              {item}
            </span>
          ))}
        </div>
      </div>
    </aside>
  </div>
</section>
