---
import { siteMeta } from "../data/site";
---

<section class="mx-auto max-w-6xl px-5 pt-10 md:px-8 md:pt-16">
  <div class="grid gap-6 lg:grid-cols-[1.05fr_0.95fr]">
    <div class="paper-panel surface-rose relative rounded-[2.8rem] px-7 py-10 md:px-10 md:py-12">
      <div class="absolute right-6 top-6 rounded-full border border-line bg-white/70 px-3 py-1 text-[0.65rem] tracking-[0.3em] text-accent-deep">
        {siteMeta.heroLabel}
      </div>

      <div class="max-w-3xl">
        <p class="section-kicker">Quiet Presence</p>
        <h1 class="mt-5 whitespace-pre-line font-display text-5xl leading-[0.92] text-text md:text-7xl">
          {siteMeta.heroTitle}
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-muted md:text-xl">
          {siteMeta.heroIntro}
        </p>
        <p class="mt-8 max-w-2xl border-l border-accent/60 pl-4 text-sm leading-7 text-accent-deep">
          {siteMeta.heroNote}
        </p>
      </div>
    </div>

    <aside class="grid gap-6">
      <div class="paper-panel hero-visual relative overflow-hidden rounded-[2.3rem] px-6 py-7 min-h-[24rem]">
        <div class="flex items-start justify-between gap-3">
          <p class="section-kicker">Main Visual</p>
          <span class="soft-chip">Mist Blue · Sakura Pink</span>
        </div>

        <div class="hero-visual__frame mt-5">
          <div class="anime-figure">
            <div class="anime-figure__halo"></div>
            <div class="anime-figure__moon"></div>
            <div class="anime-figure__veil"></div>
            <div class="anime-figure__petal anime-figure__petal--1"></div>
            <div class="anime-figure__petal anime-figure__petal--2"></div>
            <div class="anime-figure__petal anime-figure__petal--3"></div>
            <div class="anime-figure__hair"></div>
            <div class="anime-figure__face"></div>
            <div class="anime-figure__neck"></div>
            <div class="anime-figure__shoulder"></div>
            <div class="anime-figure__ribbon"></div>
          </div>
        </div>

        <div class="mt-5 flex items-end justify-between gap-4">
          <p class="hero-visual__caption">
            主视觉更像一张情绪插页，只给首页留下一点辨识度，不抢走阅读的重心。
          </p>
          <span class="soft-chip">Editorial Anime</span>
        </div>
      </div>

      <div class="paper-panel surface-mist rounded-[2rem] px-6 py-7">
        <p class="section-kicker">Site Scope</p>
        <div class="mt-5 space-y-5">
          {siteMeta.quickFacts.map((fact) => (
            <div class="border-b border-line pb-4 last:border-b-0 last:pb-0">
              <p class="text-xs uppercase tracking-[0.22em] text-muted">{fact.label}</p>
              <p class="mt-2 font-display text-2xl text-text">{fact.value}</p>
            </div>
          ))}
        </div>

        <div class="mt-6 flex flex-wrap gap-2">
          {siteMeta.status.map((item) => (
            <span class="rounded-full border border-line bg-white/76 px-3 py-1 text-xs tracking-[0.14em] text-accent-deep">
              {item}
            </span>
          ))}
        </div>
      </div>
    </aside>
  </div>
</section>
