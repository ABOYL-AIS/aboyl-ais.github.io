---
import { withBase } from "../utils/paths";

interface Props {
  title: string;
  summary: string;
  kind: string;
  venue: string;
  date: string;
  tags: string[];
  href: string;
}

const { title, summary, kind, venue, date, tags, href } = Astro.props;
---

<article class="paper-panel card-lift surface-mist rounded-[2.2rem] px-6 py-6 md:px-7">
  <div class="flex flex-wrap items-center gap-3">
    <span class="rounded-full border border-line bg-white/78 px-3 py-1 text-xs tracking-[0.14em] text-accent-deep">
      {kind}
    </span>
    <span class="text-xs tracking-[0.16em] text-muted">{date}</span>
  </div>

  <h3 class="mt-4 font-display text-3xl text-text">{title}</h3>
  <p class="mt-4 text-base leading-8 text-muted">{summary}</p>
  <p class="mt-4 text-sm text-text/80">载体：{venue}</p>

  <div class="mt-5 flex flex-wrap gap-2">
    {tags.map((tag) => (
      <span class="rounded-full bg-accent-soft px-3 py-1 text-xs tracking-[0.14em] text-accent-deep">
        {tag}
      </span>
    ))}
  </div>

  <a href={withBase(href)} class="inline-link mt-6">
    查看详情
  </a>
</article>
