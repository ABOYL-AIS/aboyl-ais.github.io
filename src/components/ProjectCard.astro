---
import { withBase } from "../utils/paths";

interface Props {
  title: string;
  summary: string;
  year: string;
  role: string;
  roleLabel?: string;
  detailLabel?: string;
  status: string;
  tags: string[];
  cover: string;
  coverAlt: string;
  href: string;
}

const {
  title,
  summary,
  year,
  role,
  roleLabel = "Role",
  detailLabel = "View details",
  status,
  tags,
  cover,
  coverAlt,
  href
} = Astro.props;
---

<article class="paper-panel card-lift surface-rose overflow-hidden rounded-[2.3rem] p-4 md:p-5">
  <div class="grid gap-5 md:grid-cols-[22rem_1fr] md:items-stretch">
    <a href={withBase(href)} class="block overflow-hidden rounded-[1.75rem] border border-line bg-bg-soft">
      <img
        src={withBase(cover)}
        alt={coverAlt}
        class="h-full min-h-[16rem] w-full object-cover transition-transform duration-500 hover:scale-[1.03]"
        loading="lazy"
      />
    </a>

    <div class="px-2 py-2 md:px-3">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="section-kicker">{year}</p>
          <h3 class="mt-3 max-w-[16ch] font-display text-[1.9rem] leading-[1.02] text-text md:text-[2.25rem]">
            {title}
          </h3>
        </div>
        <span class="rounded-full border border-line bg-white/80 px-3 py-1 text-xs tracking-[0.16em] text-accent-deep">
          {status}
        </span>
      </div>

      <p class="mt-4 max-w-2xl text-base leading-8 text-muted">{summary}</p>
      <p class="mt-4 text-sm text-text/80">{roleLabel}: {role}</p>

      <div class="mt-5 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span class="rounded-full bg-accent-soft px-3 py-1 text-xs tracking-[0.16em] text-accent-deep">
            {tag}
          </span>
        ))}
      </div>

      <a href={withBase(href)} class="inline-link mt-6">
        {detailLabel}
      </a>
    </div>
  </div>
</article>
