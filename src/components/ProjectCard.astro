---
import { withBase } from "../utils/paths";

interface Props {
  title: string;
  summary: string;
  year: string;
  role: string;
  roleLabel?: string;
  detailLabel?: string;
  status: string;
  tags: string[];
  cover: string;
  coverAlt: string;
  href: string;
}

const {
  title,
  summary,
  year,
  role,
  roleLabel = "Role",
  detailLabel = "View details",
  status,
  tags,
  cover,
  coverAlt,
  href
} = Astro.props;
---

<article class="paper-panel card-lift surface-rose overflow-hidden rounded-[1.9rem] p-3.5 sm:p-4 md:rounded-[2.3rem] md:p-5">
  <div class="grid gap-3.5 md:grid-cols-[24rem_minmax(0,1fr)] md:items-stretch xl:grid-cols-[25.5rem_minmax(0,1fr)]">
    <a href={withBase(href)} class="block overflow-hidden rounded-[1.75rem] border border-line bg-bg-soft">
      <img
        src={withBase(cover)}
        alt={coverAlt}
        class="h-full min-h-[13.5rem] w-full object-cover transition-transform duration-500 hover:scale-[1.03] md:min-h-[17rem]"
        loading="lazy"
      />
    </a>

    <div class="px-1 py-1.5 md:px-1.5 md:py-2">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
        <div>
          <p class="section-kicker">{year}</p>
          <h3 class="mt-2.5 w-full max-w-none font-display text-[1.45rem] leading-[1.05] text-text sm:text-[1.6rem] md:mt-3 md:text-[1.95rem]">
            {title}
          </h3>
        </div>
        <span class="self-start rounded-full border border-line bg-white/80 px-3 py-1 text-xs tracking-[0.16em] text-accent-deep">
          {status}
        </span>
      </div>

      <p class="mt-3.5 w-full max-w-none text-[0.95rem] leading-7 text-muted md:mt-4 md:text-[0.98rem]">{summary}</p>
      <p class="mt-3.5 text-sm leading-6 text-text/80 md:mt-4">{roleLabel}: {role}</p>

      <div class="mt-4 flex flex-wrap gap-2 md:mt-5">
        {tags.map((tag) => (
          <span class="rounded-full bg-accent-soft px-3 py-1 text-xs tracking-[0.16em] text-accent-deep">
            {tag}
          </span>
        ))}
      </div>

      <a href={withBase(href)} class="inline-link mt-5 md:mt-6">
        {detailLabel}
      </a>
    </div>
  </div>
</article>
