---
import { withBase } from "../utils/paths";

interface Props {
  title: string;
  summary: string;
  year: string;
  role: string;
  roleLabel?: string;
  detailLabel?: string;
  status: string;
  tags: string[];
  cover: string;
  coverAlt: string;
  href: string;
}

const {
  title,
  summary,
  year,
  role,
  roleLabel = "Role",
  detailLabel = "View details",
  status,
  tags,
  cover,
  coverAlt,
  href
} = Astro.props;
---

<article class="paper-panel card-lift surface-rose rounded-[2.2rem] px-6 py-6 md:px-7">
  <a href={withBase(href)} class="block overflow-hidden rounded-[1.4rem] border border-line bg-bg-soft">
    <img src={withBase(cover)} alt={coverAlt} class="h-48 w-full object-cover transition-transform duration-500 hover:scale-[1.03]" loading="lazy" />
  </a>

  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="mt-5 section-kicker">{year}</p>
      <h3 class="mt-3 font-display text-3xl text-text">{title}</h3>
    </div>
    <span class="rounded-full border border-line bg-white/80 px-3 py-1 text-xs tracking-[0.16em] text-accent-deep">
      {status}
    </span>
  </div>

  <p class="mt-4 text-base leading-8 text-muted">{summary}</p>
  <p class="mt-4 text-sm text-text/80">{roleLabel}: {role}</p>

  <div class="mt-5 flex flex-wrap gap-2">
    {tags.map((tag) => (
      <span class="rounded-full bg-accent-soft px-3 py-1 text-xs tracking-[0.16em] text-accent-deep">
        {tag}
      </span>
    ))}
  </div>

  <a href={withBase(href)} class="inline-link mt-6">
    {detailLabel}
  </a>
</article>
