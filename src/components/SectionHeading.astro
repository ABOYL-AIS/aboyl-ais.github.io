---
interface Props {
  kicker: string;
  title: string;
  intro?: string;
  titleClass?: string;
  introClass?: string;
}

const {
  kicker,
  title,
  intro,
  titleClass = "w-full max-w-none text-[clamp(1.9rem,9vw,3.25rem)] leading-[0.98] tracking-[-0.018em]",
  introClass = "w-full max-w-none text-[0.98rem] leading-7 text-muted md:text-lg md:leading-8",
} = Astro.props;
---

<div class="w-full">
  <p class="section-kicker">{kicker}</p>
  <h2 class:list={["mt-4 font-display text-text", titleClass]}>
    {title}
  </h2>
  {intro && <p class:list={["mt-5", introClass]}>{intro}</p>}
</div>
