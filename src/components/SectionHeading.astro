---
interface Props {
  kicker: string;
  title: string;
  intro?: string;
}

const { kicker, title, intro } = Astro.props;
---

<div class="max-w-4xl">
  <p class="section-kicker">{kicker}</p>
  <h2 class="mt-4 max-w-none font-display text-[clamp(2rem,4.1vw,4.15rem)] leading-[0.94] tracking-[-0.02em] text-text md:whitespace-nowrap">
    {title}
  </h2>
  {intro && <p class="mt-5 max-w-3xl text-base leading-7 text-muted md:text-lg md:leading-8">{intro}</p>}
</div>
