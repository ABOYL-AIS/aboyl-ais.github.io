---
import GalleryDetailView from "../../views/GalleryDetailView.astro";
import { getEntrySlug, getLocalizedCollection } from "../../utils/content";

export async function getStaticPaths() {
  const entries = await getLocalizedCollection("gallery", "zh");

  return entries.map((entry) => ({
    params: { slug: getEntrySlug(entry.id) },
    props: { entry }
  }));
}

const { entry } = Astro.props;
---

<GalleryDetailView locale="zh" entry={entry} />
