---
import ResearchDetailView from "../../../views/ResearchDetailView.astro";
import { getEntrySlug, getLocalizedCollection } from "../../../utils/content";

export async function getStaticPaths() {
  const entries = await getLocalizedCollection("research", "en");

  return entries.map((entry) => ({
    params: { slug: getEntrySlug(entry.id) },
    props: { entry }
  }));
}

const { entry } = Astro.props;
---

<ResearchDetailView locale="en" entry={entry} />
