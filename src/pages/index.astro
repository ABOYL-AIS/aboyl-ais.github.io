---
import { getCollection } from "astro:content";
import BentoCard from "../components/BentoCard.astro";
import HeroPanel from "../components/HeroPanel.astro";
import ProjectCard from "../components/ProjectCard.astro";
import QuoteCard from "../components/QuoteCard.astro";
import ResearchCard from "../components/ResearchCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import WritingCard from "../components/WritingCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { bentoHighlights, homeSections, siteMeta } from "../data/site";

const projects = (await getCollection("projects"))
  .filter((entry) => entry.data.featured)
  .slice(0, 2);

const research = (await getCollection("research"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);

const notes = (await getCollection("notes"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);

const gallery = (await getCollection("gallery"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);

const quote = (await getCollection("gallery"))
  .filter((entry) => entry.data.kind === "Quote")
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];

const galleryPreview = (await getCollection("gallery"))
  .filter((entry) => entry.data.kind !== "Quote")
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);
---

<BaseLayout>
  <HeroPanel />

  <section class="mx-auto mt-20 max-w-6xl px-5 md:px-8">
    <div class="paper-panel surface-lilac rounded-[2.8rem] px-7 py-9 md:px-10">
      <p class="section-kicker">Design Principle</p>
      <p class="mt-5 max-w-4xl font-display text-3xl leading-tight text-text md:text-5xl">
        {homeSections.statement}
      </p>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-muted">{homeSections.about}</p>
    </div>
  </section>

  <section class="mx-auto mt-20 max-w-6xl px-5 md:px-8">
    <SectionHeading
      kicker="Homepage Structure"
      title="首页负责建立气质与层级，而不是试图解释一切。"
      intro="这里保留卡片式入口，但把模板味压低，让每个区块更像一张安静的内容索引卡。"
    />

    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      {bentoHighlights.map((item, index) => (
        <BentoCard
          kicker={item.kicker}
          title={item.title}
          body={item.body}
          tone={item.tone}
          href={index === 0 ? "/about/" : index === 1 ? "/research/" : "/gallery/"}
          className={index === 0 ? "lg:col-span-2" : ""}
        />
      ))}

      <BentoCard
        kicker="Keywords"
        title={siteMeta.profile.keywords.join(" · ")}
        body="方向关键词会在 About 中作为更完整的个人信息展开。"
        href="/about/"
        tone="soft"
      />

      {notes.slice(0, 1).map((entry) => (
        <BentoCard
          kicker="Notes"
          title={entry.data.title}
          body={entry.data.summary}
          href={`/notes/${entry.id}/`}
          tone="soft"
        />
      ))}

      {research.slice(0, 1).map((entry) => (
        <BentoCard
          kicker="Research"
          title={entry.data.title}
          body={entry.data.summary}
          href={`/research/${entry.id}/`}
          tone="neutral"
        />
      ))}

      {gallery.map((entry) => (
        <BentoCard
          kicker={entry.data.kind}
          title={entry.data.title}
          body={entry.data.summary}
          href={`/gallery/${entry.id}/`}
          tone="soft"
        />
      ))}
    </div>
  </section>

  <section class="mx-auto mt-20 max-w-6xl px-5 md:px-8">
    <SectionHeading
      kicker="Selected Projects"
      title="项目页承担公开展示，但不把整个站点做成作品集模板。"
      intro="项目是站点的一部分，而不是站点的全部。这里会展示持续建设中的模块、专题与公开成果。"
    />

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      {projects.map((entry) => (
        <ProjectCard
          title={entry.data.title}
          summary={entry.data.summary}
          year={entry.data.year}
          role={entry.data.role}
          status={entry.data.status}
          tags={entry.data.tags}
          cover={entry.data.cover}
          coverAlt={entry.data.coverAlt}
          href={`/projects/${entry.id}/`}
        />
      ))}
    </div>
  </section>

  <section class="mx-auto mt-20 max-w-6xl px-5 pb-8 md:px-8">
    <SectionHeading
      kicker="Research"
      title="研究、竞赛、报告与成果共享同一层正式展示。"
      intro="Research 页面用于承载更正式的输出，不让它们散落在普通笔记和项目列表之间。"
    />

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      {research.map((entry) => (
        <ResearchCard
          title={entry.data.title}
          summary={entry.data.summary}
          kind={entry.data.kind}
          venue={entry.data.venue}
          date={entry.data.date.toLocaleDateString("zh-CN")}
          tags={entry.data.tags}
          href={`/research/${entry.id}/`}
        />
      ))}
    </div>
  </section>

  <section class="mx-auto mt-20 max-w-6xl px-5 pb-8 md:px-8">
    <SectionHeading
      kicker="Notes"
      title="记录与随笔保留轻重层次。"
      intro="Notes 承接技术记录、灵感随笔、阶段总结与其他长期沉淀中的文字内容。"
    />

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      {notes.map((entry) => (
        <WritingCard
          title={entry.data.title}
          summary={entry.data.summary}
          date={entry.data.date.toLocaleDateString("zh-CN")}
          readingTime={entry.data.kind}
          href={`/notes/${entry.id}/`}
        />
      ))}
    </div>
  </section>

  {quote && (
    <section class="mx-auto mt-20 max-w-6xl px-5 md:px-8">
      <SectionHeading
        kicker="Quote"
      title="留一小块位置，专门放值得反复回看的句子。"
      intro="Quote 不被并入长文列表，而是作为更轻、更私人的内容入口存在。"
      />

      <div class="mt-10">
        <QuoteCard
          title={quote.data.title}
          summary={quote.data.summary}
          source={quote.data.source}
          href={`/gallery/${quote.id}/`}
        />
      </div>
    </section>
  )}

  <section class="mx-auto mt-20 max-w-6xl px-5 pb-8 md:px-8">
    <SectionHeading
      kicker="Gallery Preview"
      title="让图像成为气质的补充，而不是页面的主角。"
      intro="这里保留图集与小型图文收藏的预览，图片负责情绪，排版负责秩序，语气则更私人一些。"
    />

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      {galleryPreview.map((entry) => (
        <BentoCard
          kicker={entry.data.medium}
          title={entry.data.title}
          body={entry.data.summary}
          href={`/gallery/${entry.id}/`}
          tone="soft"
        />
      ))}
    </div>
  </section>
</BaseLayout>
