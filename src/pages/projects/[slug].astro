---
import ProjectDetailView from "../../views/ProjectDetailView.astro";
import { getLocalizedCollection, getEntrySlug } from "../../utils/content";

export async function getStaticPaths() {
  const entries = await getLocalizedCollection("projects", "zh");

  return entries.map((entry) => ({
    params: { slug: getEntrySlug(entry.id) },
    props: { entry }
  }));
}

const { entry } = Astro.props;
---

<ProjectDetailView locale="zh" entry={entry} />
