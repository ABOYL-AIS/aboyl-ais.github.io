---
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { getBrandTitle, getCompositeBrandName, getSiteCopy } from "../data/site";
import {
  getLangTag,
  getLocaleFromPathname,
  switchLocalePath,
  type Locale
} from "../i18n/config";

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  htmlClass?: string;
  bodyClass?: string;
  mainClass?: string;
}

const {
  locale = getLocaleFromPathname(Astro.url.pathname),
  title = getBrandTitle(locale),
  description = getSiteCopy(locale).meta.description,
  htmlClass = "",
  bodyClass = "",
  mainClass = ""
} = Astro.props;
const copy = getSiteCopy(locale);
const lang = getLangTag(locale);
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.toString();
const alternatePath = switchLocalePath(Astro.url.pathname, locale === "zh" ? "en" : "zh");
const alternateUrl = Astro.site
  ? new URL(alternatePath, Astro.site).toString()
  : new URL(alternatePath, Astro.url).toString();
---

<!doctype html>
<html lang={lang} class={htmlClass}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content="Astro" />
    <meta name="theme-color" content="#fcf9f4" />
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <link rel="shortcut icon" href="/favicon.jpg" />
    <link rel="apple-touch-icon" href="/favicon.jpg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale === "zh" ? "en" : "zh-CN"} href={alternateUrl} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={getCompositeBrandName(locale)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      (() => {
        const THEME_KEY = "aboyl-theme";
        const storedTheme = localStorage.getItem(THEME_KEY);
        const preferredTheme =
          storedTheme === "light" || storedTheme === "dark"
            ? storedTheme
            : window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";

        document.documentElement.dataset.theme = preferredTheme;
        document.documentElement.style.colorScheme = preferredTheme;
        const metaTheme = document.querySelector('meta[name="theme-color"]');
        if (metaTheme) {
          metaTheme.setAttribute("content", preferredTheme === "dark" ? "#16161d" : "#fcf9f4");
        }
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-white focus:px-4 focus:py-2 focus:text-text">
      {copy.common.skipToContent}
    </a>
    <div class="page-shell">
      <SiteHeader locale={locale} />
      <main id="main-content" class={mainClass}>
        <slot />
      </main>
      <SiteFooter locale={locale} />
    </div>
  </body>
</html>
